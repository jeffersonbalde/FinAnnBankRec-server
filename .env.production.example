# Production template (DigitalOcean Droplet, one domain for client + API).
# Copy to .env on the server, replace every CHANGE_ME, then:
#   php artisan key:generate --force
#   php artisan config:cache
# Never commit the real .env.

APP_NAME=FABReS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Use a dedicated DB user (NOT root) — or the DigitalOcean Managed Database values.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=FinnAnnBankRec
DB_USERNAME=finann
DB_PASSWORD=CHANGE_ME

# --- Session / Sanctum (SPA and API share ONE domain, served over HTTPS) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Your domain without scheme or port (e.g. bankrec.example.com). Leave empty when
# using a bare IP address.
SESSION_DOMAIN=CHANGE_ME.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FRONTEND_URLS=https://CHANGE_ME.example.com
SANCTUM_STATEFUL_DOMAINS=CHANGE_ME.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# Profile photos in a DigitalOcean Spaces bucket. REQUIRED on DigitalOcean App Platform, whose
# disk is wiped on every deploy. Leave SPACES_BUCKET empty on a server with a persistent disk.
# Use a Limited Access Key for this one bucket. Everything goes under SPACES_ROOT, so the bucket can be shared.
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=sgp1
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_URL=https://CHANGE_ME_BUCKET.sgp1.digitaloceanspaces.com
SPACES_ROOT=finann
